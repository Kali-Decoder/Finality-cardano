{
  "name": "finality-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "bash scripts/run-finality.sh",
    "dev:frontend": "bash scripts/run-frontend.sh",
    "dev:merchant": "bash scripts/run-merchant.sh",
    "dev:x402": "tsx --env-file=x402-server/.env x402-server/index.ts",
    "build": "next build --webpack",
    "build:x402": "tsc -p x402-server/tsconfig.json",
    "start": "next start",
    "start:x402": "tsx --env-file=x402-server/.env x402-server/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "check:discovery": "tsx --env-file=.env.local scripts/check-discovery.ts",
    "buyer:generate": "tsx --env-file=x402-server/.env scripts/preprod-buyer.ts generate",
    "buyer:balance": "tsx --env-file=x402-server/.env scripts/preprod-buyer.ts balance",
    "buyer:buy": "tsx --env-file=x402-server/.env scripts/preprod-buyer.ts buy",
    "demo:burst": "tsx --env-file=x402-server/.env scripts/demo-burst.ts"
  },
  "dependencies": {
    "@harmoniclabs/buildooor": "^0.2.9",
