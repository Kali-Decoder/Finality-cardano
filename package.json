    "dotted-map": "^3.1.0",
    "express": "^4",
    "framer-motion": "^13.4.1",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "motion": "^13.5.1",
    "next": "^16.3.5",
    "openai": "^4.77.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
