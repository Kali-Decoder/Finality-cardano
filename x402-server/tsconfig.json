{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "resolveJsonModule": true,
    "declaration": false
  },
  "include": ["./**/*.ts", "../lib/**/*.ts", "../x402/srv/**/*.ts"],
  "exclude": ["dist", "../x402/test", "../x402/examples"]
}
